{
  "name": "ioredis-streams",
  "version": "2.1.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "author": "Zaid Al-Omari",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Zaid-AlOmari/ioredis-streams"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.5"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "nyc": {
    "include": [
      "dist-test/src/**/*.js",
      "src/**/*.ts"
    ],
    "exclude": [
      "dist-test/src/example.js",
      "dist-test/src/index.js",
      "src/index.ts",
      "src/example.ts"
    ],
    "reporter": [
      "text",
      "html"
    ]
  },
  "scripts": {
    "build": "./node_modules/.bin/tsc --p tsconfig.json",
    "test": "cd test && ../node_modules/.bin/tsc -p . && cd .. && NODE_ENV=test node_modules/.bin/nyc --use-spawn-wrap --silent node_modules/.bin/mocha --require source-map-support/register --require ./dist-test/test/setup.js --timeout 60000 './dist-test/**/*.spec.js' && node coverage.js",
    "type-check": "tsc --noEmit",
    "lint": "./node_modules/.bin/eslint src/*/*.ts --format codeframe",
    "fix-lint": "./node_modules/.bin/eslint src/*/*.ts --fix"
  },
  "dependencies": {
    "@log4js-node/log4js-api": "^1.0.2",
    "ioredis": "^4.28.5"
  },
  "devDependencies": {
    "@types/chai": "^4.2.3",
    "@types/chai-as-promised": "^8.0.2",
    "@types/ioredis": "^4.28.5",
    "@types/mocha": "^10.0.0",
    "@types/node": "^10.12.2",
    "@types/sinon": "^7.5.0",
    "@typescript-eslint/eslint-plugin": "^4.22.0",
    "@typescript-eslint/experimental-utils": "^4.22.0",
    "@typescript-eslint/parser": "^4.22.0",
    "chai": "^4.2.0",
    "chai-as-promised": "^8.0.2",
    "eslint": "^7.0.0",
    "mocha": "^11.7.5",
    "nyc": "^18.0.0",
    "sinon": "^9.0.2",
    "sinon-chai": "^3.5.0",
    "source-map-support": "^0.5.19",
    "typescript": "^4.6.2"
  }
}
